{
  "name": "rentplace-api",
  "version": "1.0.0",
  "description": "RentPlace REST API (Express + Prisma + Stripe)",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "stripe:webhook": "stripe listen --events checkout.session.completed --forward-to localhost:5000/api/payments/webhook",
