# Base URL of the RentPlace API (no trailing slash).
# - Browser requests always go to same-origin /api/* and are forwarded by the
#   rewrite in next.config.ts (avoids CORS on the API host).
# - This value is used for the rewrite target and for server-side (SSR) fetches.
# Point it at http://localhost:5000 to run against a local backend.
NEXT_PUBLIC_API_URL=https://rent-nest-api-seven.vercel.app
